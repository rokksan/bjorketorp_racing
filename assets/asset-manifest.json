{
  "version": 2,
  "style": {
    "name": "bjorketorp-16-bit-farm",
    "perspective": "top-down-three-quarter",
    "baseResolution": {
      "width": 480,
      "height": 300
    },
    "pixelGrid": 1,
    "palette": {
      "ink": "#393b40",
      "deep": "#304b42",
      "grass": "#89ad65",
      "grassLight": "#a0bc73",
      "grassDark": "#76985d",
      "leaf": "#527b4a",
      "leafLight": "#7b9c51",
      "leafShade": "#365d45",
      "cream": "#fff0ce",
      "white": "#fff7e1",
      "gold": "#e8b45f",
      "ochre": "#c38a4c",
      "road": "#e5c58b",
      "roadLight": "#efd59b",
      "roadShadow": "#b99566",
      "brown": "#885e49",
      "wood": "#b78056",
      "rust": "#b85f4e",
      "red": "#d87557",
      "blue": "#71969b",
      "water": "#77a5aa",
      "lilac": "#a08aaf"
    }
  },
  "sourceOfTruth": "js/art.js",
  "exportCommand": "node tools/export-assets.cjs",
  "characters": {
    "greta": {
      "name": "Svets-Greta, Byvägens sista hopp",
