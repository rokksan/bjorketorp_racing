      "frameHeight": 34,
      "anchor": {
        "x": 16,
        "y": 27
      }
    },
    "ragna": {
      "name": "Raketragge – gasol på avbetalning",
      "source": "assets/chicken/ragna-equipped.svg",
      "frameWidth": 32,
      "frameHeight": 34,
      "anchor": {
        "x": 16,
        "y": 27
      }
    },
    "par": {
      "name": "Plåt-Pär, kommunens sista 240",
      "source": "assets/chicken/par-equipped.svg",
      "frameWidth": 32,
      "frameHeight": 34,
      "anchor": {
        "x": 16,
        "y": 27
      }
    },
    "agnes": {
      "name": "Agnes Ägg.exe från kopparskjulet",
      "source": "assets/chicken/agnes-equipped.svg",
      "frameWidth": 32,
      "frameHeight": 34,
      "anchor": {
        "x": 16,
        "y": 27
      }
    }
  },
  "sprites": {
    "playerChicken": {
      "source": "assets/chicken/player-chicken-sheet.svg",
      "frameWidth": 24,
      "frameHeight": 26,
      "anchor": {
        "x": 12,
        "y": 21
      },
      "animations": {
        "idle": {
          "frames": [
            0
          ],
          "fps": 1
        },
        "run": {
          "frames": [
            0,
            1,
            2,
            3
          ],
          "fps": 12
        },
        "boost": {
          "frames": [
            0,
            1,
            2,
            3
          ],
          "fps": 18
        }
      }
    }
  },
  "environment": [
    "assets/environment/tree.svg",
    "assets/environment/apple-tree.svg",
    "assets/environment/coop.svg",
    "assets/environment/tractor.svg",
    "assets/environment/barn.svg",
    "assets/environment/pumpkins.svg",
    "assets/environment/barrels.svg",
    "assets/environment/lantern.svg",
    "assets/environment/angry-farmer.svg",
    "assets/environment/volvo240.svg",
    "assets/environment/volvo740.svg",
    "assets/environment/volvo850.svg",
    "assets/environment/caravan.svg",
    "assets/environment/wreckhouse.svg",
    "assets/environment/bottles.svg",
    "assets/environment/bushnap.svg"
